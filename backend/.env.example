# ReviveOS Backend Environment Variables Template
# For Render: set these in the Render dashboard (never commit real values)

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=<SET_IN_RENDER_DASHBOARD>
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://reviveai-five.vercel.app

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./reviveai.db

# ── Clerk (backend-only JWT verification) ────────────────────────────────────
CLERK_SECRET_KEY=<SET_IN_RENDER_DASHBOARD>

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<SET_IN_RENDER_DASHBOARD>

# ── Razorpay (backend-only, NEVER in frontend) ───────────────────────────────
RAZORPAY_KEY_ID=<SET_IN_RENDER_DASHBOARD>
RAZORPAY_KEY_SECRET=<SET_IN_RENDER_DASHBOARD>
RAZORPAY_WEBHOOK_SECRET=<SET_IN_RENDER_DASHBOARD>
