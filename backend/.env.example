# ReviveAI Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Get this from: https://dashboard.clerk.com → API Keys → Secret keys
# NEVER put this in VITE_* variables or the React frontend
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ── AI Configuration ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Razorpay Test-Mode Configuration ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_strong_random_secret_key
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./reviveai.db

# ── Recovery Policy Limits ────────────────────────────────────────────────────
MAX_RETRIES_PER_CASE=3
MAX_AUTOMATED_AMOUNT_INR=50000
MAX_CONSECUTIVE_FAILURES=2
REMINDER_COOLDOWN_HOURS=24
RETRY_COOLDOWN_MINUTES=60

# ── Simulation ────────────────────────────────────────────────────────────────
DEFAULT_SIMULATION_SCALE=10000
DEFAULT_SIMULATION_SEED=42
PRECOMPUTED_100K_PATH=./data/eval_100k.parquet
