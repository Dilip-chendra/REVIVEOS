# ReviveOS Frontend Environment Variables Template
# Copy to .env.development for local dev
# For Vercel production: set VITE_API_URL in the Vercel dashboard environment settings

# Backend API URL (NO trailing slash)
# Local:      http://localhost:8000
# Production: https://reviveai-e858.onrender.com
VITE_API_URL=http://localhost:8000

# NEVER put secrets here — Vite embeds ALL VITE_* vars into the browser bundle
